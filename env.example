# Copy this file to ".env" on the server and fill in the values. Never commit ".env".
# (Keep comments on their own lines, like these. Some tools do not accept comments after a value.)

# Required: the company's Gemini API key (created in Google AI Studio)
GOOGLE_API_KEY=

# The Google Sheet used as the knowledge base (the long code in its address)
GSHEET_ID=1Qf3iZ583CTz-S4cJJ6ZhVRBORGP0eYfAkuY0nY4C7TA

# The website's address(es), separated by commas. Leave empty if the website and this API share one address.
ALLOWED_ORIGINS=https://your-microsite-address

# Set to true when the app runs behind nginx or Azure's front end
TRUST_PROXY=true

# Messages allowed per visitor per minute
RATE_LIMIT_PER_MINUTE=20

# Optional: Redis keeps chat history across restarts and several workers.
# Azure Cache for Redis looks like: rediss://:ACCESS-KEY@NAME.redis.cache.windows.net:6380/0
REDIS_URL=

# Optional overrides
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
LOG_LEVEL=INFO

# LangSmith stores visitors' questions. Leave false unless you want it.
LANGCHAIN_TRACING_V2=false
